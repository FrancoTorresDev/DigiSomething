{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "functions": {
      "host": "127.0.0.1",
      "port": 5002
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/digimon-api/**",
        "function": "digimonProxy"
      },
      {
        "source": "/justtcg-api/**",
        "function": "justTcgPricingProxy"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
